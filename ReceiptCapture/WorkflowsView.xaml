<UserControl x:Class="ReceiptCapture.WorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FindCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style x:Key="Pick" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style x:Key="ReviewText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="430" MinWidth="320" MaxWidth="680"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>

        <!-- ================= LEFT: workflows and what they have done ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="110"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="New workflow" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0,0,8,4"/>
                    <Button Content="Duplicate" Style="{StaticResource SecondaryButton}" Command="{Binding DuplicateCommand}" Margin="0,0,8,4"/>
                    <Button Content="Delete" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" Margin="0,0,0,4"/>
                </WrapPanel>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Workflows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              RowHeight="34" ColumnHeaderHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Workflow" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Watching" Width="*" Binding="{Binding WatchFolderText}" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="State" Width="90" Binding="{Binding StateText}" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No workflows yet" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="380"
                                   Text="A workflow checks every file that lands in a folder and puts clean copies, a report and a log somewhere else."/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,14,0,6">
                    <TextBlock Text="Activity" Style="{StaticResource Heading}"/>
                    <Button Content="Clear" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                            Command="{Binding ClearActivityCommand}"/>
                </Grid>

                <DataGrid Grid.Row="3" ItemsSource="{Binding Activity}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                          BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                          RowHeight="34" ColumnHeaderHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Width="90" Binding="{Binding Time}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Workflow" Width="130" Binding="{Binding Workflow}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="File" Width="*" Binding="{Binding File}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Result" Width="*" Binding="{Binding Result}" ElementStyle="{StaticResource ReviewText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- ================= RIGHT: the selected workflow ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select or make a workflow to edit it.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding Selected}" Margin="0,0,10,0">
                        <TextBlock Text="Workflow" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Text="Watch this folder" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding WatchFolderText}" Style="{StaticResource Pick}" ToolTip="{Binding WatchFolderText}"/>
                            <Button Grid.Column="1" Content="Choose…" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                    Command="{Binding DataContext.ChooseWatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>
                        <CheckBox Content="Include subfolders" Style="{StaticResource FindCheck}" IsChecked="{Binding IncludeSubfolders}" Margin="0,6,0,0"/>

                        <TextBlock Text="Put results here" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OutputFolderText}" Style="{StaticResource Pick}" ToolTip="{Binding OutputFolderText}"/>
                            <Button Grid.Column="1" Content="Choose…" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                    Command="{Binding DataContext.ChooseOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Gets a Clean copies folder, a Reports folder and a Workflow log.csv. Originals are never changed or moved."/>

                        <TextBlock Text="Check against" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Also look for these words or names (one per line)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                        <TextBox Style="{StaticResource Input}" AcceptsReturn="True" Height="64"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Text="{Binding CustomTerms, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Client names, patient names, case numbers. Saved locked on this PC."/>

                        <TextBlock Text="For each file" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <CheckBox Content="Look for hidden content" Style="{StaticResource FindCheck}" IsChecked="{Binding CheckHiddenContent}"/>
                        <CheckBox Content="Save a report" Style="{StaticResource FindCheck}" IsChecked="{Binding SaveReports}"/>
                        <CheckBox Content="Make a clean copy when hidden content is found" Style="{StaticResource FindCheck}" IsChecked="{Binding MakeCleanCopies}"/>

                        <Expander Header="What a clean copy removes" Margin="0,10,0,0" Padding="0">
                            <StackPanel Margin="4,6,0,0">
                                <CheckBox Content="Author and other document properties" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanProperties}"/>
                                <CheckBox Content="Comments" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanComments}"/>
                                <CheckBox Content="Tracked changes (accepts them all)" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanTrackedChanges}"/>
                                <CheckBox Content="Text formatted as hidden" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanHiddenText}"/>
                                <CheckBox Content="Attached and embedded files" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanAttachments}"/>
                                <CheckBox Content="First-page preview picture" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanPreviews}"/>
                                <CheckBox Content="Picture metadata (location, camera, dates)" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanPictures}"/>
                                <CheckBox Content="Keep rebuilt PDFs searchable" Style="{StaticResource FindCheck}" IsChecked="{Binding KeepPdfSearchable}"/>
                            </StackPanel>
                        </Expander>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,14"/>

                        <CheckBox Content="Watch the folder automatically" Style="{StaticResource FindCheck}" IsChecked="{Binding WatchEnabled}"
                                  FontWeight="SemiBold"
                                  ToolTip="New files are checked as they arrive, and files already in the folder are checked once when you switch this on."/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Watching only happens while Aegis Docs is open. Files that arrive while it is closed are picked up the next time it starts."/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Check the folder now" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Files with items to review are only reported: nothing is redacted automatically, because a person should decide what to black out. Open them in the Redact tab."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
