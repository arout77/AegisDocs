<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette: same keys as Light.xaml, plus the dark-only tab colour overrides at the bottom. -->
    <SolidColorBrush x:Key="BgBrush" Color="#0D0F15"/>
    <SolidColorBrush x:Key="CardBrush" Color="#161922"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C202B"/>
    <SolidColorBrush x:Key="ViewerBgBrush" Color="#0A0C11"/>
    <SolidColorBrush x:Key="LineBrush" Color="#272C3A"/>
    <SolidColorBrush x:Key="InkBrush" Color="#E9ECF4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9099AE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7578F5"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#232552"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#9A9DFF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#222736"/>

    <!-- Dark-only overrides of ModernWpf's own tab colours, used by the Tools tabs (Merge / Split / ...).
         Light.xaml has no such entries on purpose, so light mode keeps ModernWpf's look untouched. -->
    <SolidColorBrush x:Key="TabViewBackground" Color="#0B0D13"/>
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#2A2F40"/>
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#1B1F2B"/>
</ResourceDictionary>
