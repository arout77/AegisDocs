<Window x:Class="ReceiptCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReceiptCapture"
        Title="Receipt Capture" Width="1280" Height="760" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:FilePathToImageConverter x:Key="ImageConv"/>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: list ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add files…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddFilesCommand}"/>
                        <Button Content="New entry" Style="{StaticResource SecondaryButton}"
                                Command="{Binding NewCommand}" Margin="8,0,0,0"/>
                        <Button Content="Export CSV" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExportCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Width="140" HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Filters -->
                <Grid Grid.Row="1" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search vendor, notes, or text on the receipt…"
                                   Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Grid.Column="1" Width="170" Margin="8,0,0,0" Padding="6,5"
                              ItemsSource="{Binding FilterCategories}"
                              SelectedItem="{Binding CategoryFilter}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="From" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0"/>
                        <DatePicker Width="115" SelectedDate="{Binding FromDate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="To" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0"/>
                        <DatePicker Width="115" SelectedDate="{Binding ToDate}"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="Clear" Style="{StaticResource SecondaryButton}"
                            Padding="10,5" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"/>
                </Grid>

                <!-- List + empty-state hint -->
                <Grid Grid.Row="2">
                    <DataGrid x:Name="ReceiptGrid"
                              ItemsSource="{Binding View}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              RowHeight="34" ColumnHeaderHeight="32"
                              SelectionChanged="ReceiptGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="●" ToolTip="Needs review"
                                                   Foreground="{StaticResource WarnBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Date" Width="100"
                                                Binding="{Binding Date, StringFormat={}{0:d}}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Vendor" Width="*"
                                                Binding="{Binding Vendor}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Category" Width="170"
                                                Binding="{Binding Category}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Tax" Width="90"
                                                Binding="{Binding Tax, StringFormat={}{0:C}}"
                                                ElementStyle="{StaticResource CellTextRight}"/>
                            <DataGridTextColumn Header="Total" Width="110"
                                                Binding="{Binding Total, StringFormat={}{0:C}}"
                                                ElementStyle="{StaticResource CellTextRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drop receipts or invoices here" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="PNG, JPG, or PDF. Everything is read on this PC; nothing is uploaded."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Status + summary -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= RIGHT: details ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Details" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="● Needs review" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Foreground="{StaticResource WarnBrush}"
                               Visibility="{Binding Draft.NeedsReview, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                    <StackPanel Margin="0,0,8,0">

                        <!-- Preview -->
                        <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="6" Height="200">
                            <Grid>
                                <TextBlock Text="No preview" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Draft.FilePath, Converter={StaticResource ImageConv}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Vendor" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding Draft.Vendor, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding Draft.Date}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                <ComboBox IsEditable="True" Padding="6,5"
                                          ItemsSource="{Binding CategoryChoices}"
                                          Text="{Binding Draft.Category, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource Input}" HorizontalContentAlignment="Right"
                                         Text="{Binding Draft.Total, StringFormat=N2, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tax (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource Input}" HorizontalContentAlignment="Right"
                                         Text="{Binding Draft.Tax, StringFormat=N2, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}"/>

                        <Expander Header="Text read from the file" Margin="0,12,0,0">
                            <TextBox Style="{StaticResource Input}" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Draft.RawText, Mode=OneWay}"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="Save   Ctrl+S" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Open original" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenOriginalCommand}" Margin="8,0,0,0"/>
                    <Button Content="Delete" Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource DangerBrush}"
                            Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
