<Window x:Class="ReceiptCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:ReceiptCapture"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Office Toolkit" Width="1280" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13">

    <Grid>
        <TabControl Padding="0" BorderThickness="0" Background="{DynamicResource BgBrush}">
            <TabItem Header="Documents" Padding="18,7">
                <local:DocumentsView/>
            </TabItem>
            <TabItem Header="Redact" Padding="18,7">
                <local:RedactionView/>
            </TabItem>
            <TabItem Header="Receipts" Padding="18,7">
                <local:ReceiptsView/>
            </TabItem>
        </TabControl>

        <!-- Light / dark switch, sitting in the empty space of the tab strip -->
        <Button x:Name="ThemeButton" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,18,0" Padding="14,6"
                ToolTip="Switch between Auto (follows Windows), Light and Dark"
                Click="ThemeButton_Click"/>
    </Grid>
</Window>
