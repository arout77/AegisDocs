<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The "-windows10.0.19041.0" part unlocks the built-in Windows OCR and PDF APIs. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReceiptCapture</RootNamespace>
    <AssemblyName>AegisDocs</AssemblyName>
    <ApplicationTitle>Aegis Docs</ApplicationTitle>
    <Product>Aegis Docs</Product>
    <AssemblyTitle>Aegis Docs</AssemblyTitle>
    <Description>Aegis Docs</Description>
    <ApplicationIcon>Assets\AegisDocs.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- WPF projects leave these out of the automatic "using" list, but the code relies on them. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Open-source (MIT) library for merging, splitting and stamping PDFs. -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <!-- Modern control templates with built-in light/dark support (MIT). -->
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <!-- Open-source (MIT) library for recording the microphone and computer sound (meeting recorder). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Open-source (MIT) speech-to-text, running fully on this PC. The "Runtime" packages carry the native engine files;
         NoAvx is a fallback for older processors. They land in a "runtimes" folder next to the exe. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sora (SIL Open Font License, see Fonts\OFL.txt) is embedded so the app looks the same on every PC. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo: the icon for the exe and the windows, plus the picture shown while the program starts up. -->
    <Resource Include="Assets\AegisDocs.ico" />
    <Resource Include="Assets\AegisDocs-logo.png" />
    <SplashScreen Include="Assets\Splash.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReceiptCapture.Core\ReceiptCapture.Core.csproj" />
  </ItemGroup>

</Project>
