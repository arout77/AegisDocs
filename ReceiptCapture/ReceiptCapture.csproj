<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The "-windows10.0.19041.0" part unlocks the built-in Windows OCR and PDF APIs. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReceiptCapture</RootNamespace>
    <AssemblyName>ReceiptCapture</AssemblyName>
    <ApplicationTitle>Receipt Capture</ApplicationTitle>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReceiptCapture.Core\ReceiptCapture.Core.csproj" />
  </ItemGroup>

</Project>
