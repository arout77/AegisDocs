<UserControl x:Class="ReceiptCapture.RedactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ReceiptCapture"
             Background="{DynamicResource BgBrush}"
             AllowDrop="True"
             PreviewDragOver="View_PreviewDragOver"
             PreviewDrop="View_PreviewDrop"
             PreviewKeyDown="View_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BytesToImageConverter x:Key="BytesToImage"/>

        <Style x:Key="FindCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Approved boxes look like the black bars they will become; excluded ones are just outlined. -->
        <Style x:Key="RegionBox" TargetType="Border">
            <Setter Property="Background" Value="#CC000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Approved}" Value="False">
                    <Setter Property="Background" Value="#1A000000"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="360" MinWidth="300" MaxWidth="640"/>
        </Grid.ColumnDefinitions>

        <!-- Drag this gap left or right to resize the two panels -->
        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>

        <!-- ================= LEFT: page viewer ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open file…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenCommand}"/>
                        <Button Content="Previous" Style="{StaticResource SecondaryButton}"
                                Command="{Binding PrevPageCommand}" Margin="16,0,0,0"/>
                        <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" MinWidth="90"
                                   TextAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
                        <Button Content="Next" Style="{StaticResource SecondaryButton}"
                                Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Width="140" HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource ViewerBgBrush}" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <!-- The page is scaled by a LayoutTransform (the zoom). Everything inside is still measured in
                             page-image pixels, so box positions and mouse positions need no scaling maths. -->
                        <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="PageScroller_SizeChanged"
                                      PreviewMouseWheel="PageScroller_PreviewMouseWheel">
                            <Grid Width="{Binding PageWidth}" Height="{Binding PageHeight}" Background="White"
                                  Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding EffectiveScale}" ScaleY="{Binding EffectiveScale}"/>
                                </Grid.LayoutTransform>
                                <Image Stretch="Fill"
                                       Source="{Binding CurrentPagePng, Converter={StaticResource BytesToImage}}"/>

                                <!-- Layer 1: catches drags on empty page area to draw a new box -->
                                <Canvas x:Name="DrawCanvas" Background="Transparent" Cursor="Cross"
                                        MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                                        MouseMove="DrawCanvas_MouseMove"
                                        MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp">
                                    <Rectangle x:Name="PreviewRect" Visibility="Collapsed"
                                               Stroke="#DC2626" StrokeThickness="3" StrokeDashArray="4 2" Fill="#33DC2626"/>
                                </Canvas>

                                <!-- Layer 2: the found / drawn boxes (click toggles, right-click removes hand-drawn) -->
                                <ItemsControl ItemsSource="{Binding CurrentRegions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RegionBox}"
                                                    Width="{Binding Width}" Height="{Binding Height}"
                                                    ToolTip="{Binding Label}"
                                                    MouseLeftButtonDown="Region_MouseLeftButtonDown"
                                                    MouseRightButtonDown="Region_MouseRightButtonDown"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <!-- Floating zoom controls (Ctrl + mouse wheel, Ctrl +/-, and Ctrl 0 also work) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="4"
                                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" ToolTip="Zoom out (Ctrl + minus)" Padding="13,5"
                                        Style="{StaticResource SecondaryButton}" Command="{Binding ZoomOutCommand}"/>
                                <Button Content="{Binding ZoomPercent}" ToolTip="Actual size (100%)" MinWidth="64"
                                        Margin="4,0" Padding="8,5"
                                        Style="{StaticResource SecondaryButton}" Command="{Binding Zoom100Command}"/>
                                <Button Content="+" ToolTip="Zoom in (Ctrl + plus)" Padding="13,5"
                                        Style="{StaticResource SecondaryButton}" Command="{Binding ZoomInCommand}"/>
                                <Button Content="Fit" ToolTip="Fit the page to the window (Ctrl + 0)" Margin="4,0,0,0"
                                        Padding="12,5" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ZoomFitCommand}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding NoDocument, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Open or drop a PDF, Word document or picture to begin" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,6,0,0" MaxWidth="420"
                                       Text="Scanned or digital, it makes no difference. Word documents need Word (or LibreOffice) installed; pictures can be JPG, PNG or TIFF. Everything is read on this PC; nothing is uploaded. You can also drag on the page to black out anything by hand."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- ================= RIGHT: what to find + review list ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Find automatically" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                    <UniformGrid Columns="2">
                        <CheckBox Content="SSNs" Style="{StaticResource FindCheck}" IsChecked="{Binding FindSsn}"
                                  ToolTip="Social Security numbers, like 123-45-6789"/>
                        <CheckBox Content="Phone numbers" Style="{StaticResource FindCheck}" IsChecked="{Binding FindPhone}"
                                  ToolTip="US phone numbers in common formats"/>
                        <CheckBox Content="Emails" Style="{StaticResource FindCheck}" IsChecked="{Binding FindEmail}"
                                  ToolTip="Email addresses"/>
                        <CheckBox Content="Card numbers" Style="{StaticResource FindCheck}" IsChecked="{Binding FindCards}"
                                  ToolTip="13 to 19 digit credit and debit card numbers that pass the card checksum"/>
                        <CheckBox Content="Dates of birth" Style="{StaticResource FindCheck}" IsChecked="{Binding FindDob}"
                                  ToolTip="Dates labelled DOB, date of birth or born"/>
                        <CheckBox Content="Street addresses" Style="{StaticResource FindCheck}" IsChecked="{Binding FindAddress}"
                                  ToolTip="US street addresses (123 Main Street, Apt 4B) and P.O. boxes, plus the city, state and ZIP that follow"/>
                        <CheckBox Content="EIN / tax ID" Style="{StaticResource FindCheck}" IsChecked="{Binding FindEin}"
                                  ToolTip="Numbers shaped like 12-3456789, or any number labelled EIN or Tax ID"/>
                        <CheckBox Content="Bank accounts" Style="{StaticResource FindCheck}" IsChecked="{Binding FindBank}"
                                  ToolTip="Numbers that follow Account, Acct or A/C"/>
                        <CheckBox Content="Routing numbers" Style="{StaticResource FindCheck}" IsChecked="{Binding FindRouting}"
                                  ToolTip="9-digit numbers that follow Routing, ABA or RTN"/>
                        <CheckBox Content="Driver's license" Style="{StaticResource FindCheck}" IsChecked="{Binding FindLicense}"
                                  ToolTip="Numbers that follow Driver's License, DL or License No."/>
                        <CheckBox Content="Passports" Style="{StaticResource FindCheck}" IsChecked="{Binding FindPassport}"
                                  ToolTip="Numbers that follow the word Passport"/>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Account, routing, license and passport numbers are found by the label printed next to them. Anything else, add below."/>


                    <TextBlock Text="Also redact these words or names (one per line)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" AcceptsReturn="True" Height="56"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Text="{Binding CustomTermsText, UpdateSourceTrigger=LostFocus}"/>

                    <Grid Margin="0,14,0,6">
                        <TextBlock Text="Review" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="All" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                    Command="{Binding ApproveAllCommand}"/>
                            <Button Content="None" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                    Command="{Binding ApproveNoneCommand}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}"
                         BorderBrush="{DynamicResource LineBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Approved}" Margin="2,3">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Label}"/>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <CheckBox Content="Keep the copy searchable" Style="{StaticResource FindCheck}"
                              IsChecked="{Binding MakeSearchable}" Margin="0,0,0,10"
                              ToolTip="Adds back the text that was NOT covered by a box as an invisible layer, so the saved PDF can be searched and copied from. Covered text is never included. Turn this off for a copy that is pictures only."/>
                    <Button Content="Save redacted copy…" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Command="{Binding ApplyCommand}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="On the page: click a box to include or exclude it, drag to draw your own, right-click a hand-drawn box to remove it. Redacted pages are saved as pictures, so whatever was under a box is truly gone. With &quot;Keep the copy searchable&quot; on, only the uncovered words are added back as hidden text."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
