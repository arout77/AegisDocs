<UserControl x:Class="ReceiptCapture.ShredderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             AllowDrop="True"
             PreviewDragOver="View_PreviewDragOver"
             PreviewDrop="View_PreviewDrop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="400" MinWidth="300" MaxWidth="700"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>

        <!-- ================= LEFT: what will be shredded ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add files…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddFilesCommand}"/>
                        <Button Content="Add folder…" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddFolderCommand}" Margin="8,0,0,0"/>
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                ToolTip="Takes the selected item off this list. The file itself is not touched."
                                Command="{Binding RemoveCommand}" Margin="8,0,0,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                                ToolTip="Empties this list. No files are touched."
                                Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Width="140" HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              RowHeight="34" ColumnHeaderHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Type" Width="80"
                                                Binding="{Binding Kind}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Size" Width="150"
                                                Binding="{Binding Detail}"
                                                ElementStyle="{StaticResource CellTextRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drop files or folders here" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="They are only shredded when you press Shred."
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- ================= RIGHT: options and the big button ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Secure file shredder" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Overwrites each file with random data, empties it, renames it, and then deletes it. It skips the Recycle Bin, so what you shred cannot be recovered with undelete tools."/>

                    <TextBlock Text="Overwrite passes" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <ComboBox Padding="6,5" ItemsSource="{Binding PassChoices}" SelectedItem="{Binding Passes, Mode=TwoWay}"
                              HorizontalAlignment="Left" MinWidth="90"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="More passes take longer. One pass is enough on modern drives; three is the default."/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Shred" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ShredCommand}"/>
                        <Button Content="Stop" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                ToolTip="Finishes the file being shredded, then stops."
                                Command="{Binding StopCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Good to know" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="On a solid-state drive (most laptops), the drive can keep old copies of data in places no program can reach. Shredding is still a strong step, but full-disk encryption (BitLocker) is the only complete protection there."/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Shredding does not reach backups, copies in cloud folders such as OneDrive, or copies you emailed or saved elsewhere."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
