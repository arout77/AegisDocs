<Application x:Class="ReceiptCapture.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpfUI: modern templates for the standard controls (combo boxes, date pickers,
                     grids, scroll bars...) in both light and dark. Must stay first. -->
                <ui:ThemeResources />
                <ui:XamlControlsResources />
                <!-- Our palette. AppTheme.cs replaces this entry with Dark.xaml when dark mode is active. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- Our shared styles (cards, buttons, inputs). -->
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sora ships inside the app (Fonts folder), so it works on any PC. If it ever failed to
                 load, Windows quietly falls back to its default font. -->
            <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Sora</FontFamily>
            <FontFamily x:Key="HeadingFont">pack://application:,,,/Fonts/#Sora SemiBold</FontFamily>
            <!-- Makes ModernWpf's own controls use Sora too. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Fonts/#Sora</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
