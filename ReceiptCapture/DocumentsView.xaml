<UserControl x:Class="ReceiptCapture.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}"
             AllowDrop="True"
             PreviewDragOver="View_PreviewDragOver"
             PreviewDrop="View_PreviewDrop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: batch list ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add files…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddFilesCommand}"/>
                        <Button Content="↑" Style="{StaticResource SecondaryButton}" ToolTip="Move up"
                                Command="{Binding MoveUpCommand}" Margin="8,0,0,0" Padding="12,7"/>
                        <Button Content="↓" Style="{StaticResource SecondaryButton}" ToolTip="Move down"
                                Command="{Binding MoveDownCommand}" Margin="4,0,0,0" Padding="12,7"/>
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RemoveCommand}" Margin="8,0,0,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Width="140" HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              RowHeight="34" ColumnHeaderHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Width="*"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Pages" Width="80"
                                                Binding="{Binding PagesText}"
                                                ElementStyle="{StaticResource CellTextRight}"/>
                            <DataGridTextColumn Header="Size" Width="90"
                                                Binding="{Binding SizeText}"
                                                ElementStyle="{StaticResource CellTextRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drop PDFs here" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Or drop a whole folder. Everything stays on this PC."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- ================= RIGHT: tools ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tools" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,8"/>

                <TabControl Grid.Row="1" Padding="10">

                    <!-- Merge -->
                    <TabItem Header="Merge">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Joins every PDF in the list into one file, in the order shown. Use ↑ ↓ to reorder."/>
                            <TextBlock Text="Name of the merged file" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding MergeName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Merge" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Left" Command="{Binding MergeCommand}"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Split -->
                    <TabItem Header="Split">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Splits the PDF selected in the list into separate files."/>
                            <RadioButton GroupName="SplitMode" Content="Extract page ranges" Margin="0,8,0,0"
                                         IsChecked="{Binding SplitByRanges}"/>
                            <TextBox Style="{StaticResource Input}" Margin="22,4,0,0"
                                     Text="{Binding SplitRanges, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                                       Text="One file per comma: &quot;1-3, 5, 8-&quot; makes three files. &quot;8-&quot; means page 8 to the end."/>
                            <RadioButton GroupName="SplitMode" Content="Every N pages" Margin="0,10,0,0"
                                         IsChecked="{Binding SplitByEvery}"/>
                            <TextBox Style="{StaticResource Input}" Margin="22,4,0,0" Width="80" HorizontalAlignment="Left"
                                     Text="{Binding SplitEveryN, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            <Button Content="Split selected PDF" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Left" Command="{Binding SplitCommand}"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Bates -->
                    <TabItem Header="Bates">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Stamps a running page number at the bottom-right of every page. Numbering continues from one file to the next, in list order."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding BatesPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Suffix" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding BatesSuffix, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start at" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding BatesStart, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Digits" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding BatesDigits, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Stamp all PDFs" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Left" Command="{Binding BatesCommand}"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Watermark -->
                    <TabItem Header="Watermark">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Draws light grey diagonal text across every page of every PDF in the list."/>
                            <TextBlock Text="Watermark text" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Add watermark" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Left" Command="{Binding WatermarkCommand}"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Rename -->
                    <TabItem Header="Rename">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Copies the files with new names. {name} = original name, {n:000} = running number, {date} = today."/>
                            <TextBlock Text="Pattern" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding RenamePattern, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="First number" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding RenameStart, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            <TextBlock Text="Preview" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8">
                                <TextBlock Text="{Binding RenamePreview}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <Button Content="Copy with new names" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Left" Command="{Binding RenameCommand}"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Output folder -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Results are saved to" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding OutputFolderText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource InkBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Change…" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ChooseOutputCommand}"/>
                        <Button Content="Open folder" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenOutputCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
