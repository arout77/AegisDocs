<Window x:Class="ReceiptCapture.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Office Toolkit Help" Width="900" Height="660" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="TopicList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="TopicList_SelectionChanged"/>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel" Margin="0,0,12,0"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
