<UserControl x:Class="ReceiptCapture.ComplianceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ChromeBrush}"
             AllowDrop="True"
             PreviewDragOver="View_PreviewDragOver"
             PreviewDrop="View_PreviewDrop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FindCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Low">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="380" MinWidth="300" MaxWidth="640"/>
        </Grid.ColumnDefinitions>

        <!-- Drag this gap left or right to resize the two panels -->
        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>

        <!-- ================= LEFT: files and what was found ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button Content="Add files…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddFilesCommand}" Margin="0,0,8,4"/>
                        <Button Content="Add folder…" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddFolderCommand}" Margin="0,0,8,4"/>
                        <CheckBox Content="Include subfolders" Style="{StaticResource FindCheck}"
                                  IsChecked="{Binding IncludeSubfolders}" Margin="0,0,12,4" VerticalAlignment="Center"
                                  ToolTip="When you add a folder, also add the readable files in the folders inside it."/>
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RemoveCommand}" Margin="0,0,8,4"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearCommand}" Margin="0,0,0,4"/>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,4"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Height="3" Width="90" VerticalAlignment="Center"/>
                        <Button Content="Stop" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}" Margin="10,0,0,0"
                                ToolTip="Stops after the file being read now. Files not reached are listed as not scanned."/>
                    </StackPanel>
                </Grid>

                <!-- Files -->
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              RowHeight="34" ColumnHeaderHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Width="*"
                                                Binding="{Binding DisplayName}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Result" Width="220"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drop files or a folder here" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,6,0,0" MaxWidth="380"
                                   Text="Files or whole folders: PDFs, Word documents and pictures, scanned or digital. Everything is read on this PC; nothing is uploaded."/>
                    </StackPanel>
                </Grid>

                <!-- What was found in the selected file -->
                <StackPanel Grid.Row="2" Margin="0,14,0,6">
                    <TextBlock Text="{Binding FindingsHeader}" Style="{StaticResource Heading}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FindingsHeader}"/>
                    <TextBlock Text="{Binding FindingsNote}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                </StackPanel>

                <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabItem Header="{Binding FoundTabHeader}">
                        <DataGrid ItemsSource="{Binding Findings}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                                  BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                  RowHeight="30" ColumnHeaderHeight="30" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Width="84"
                                                    Binding="{Binding Severity}"
                                                    ElementStyle="{StaticResource SeverityText}"/>
                                <DataGridTextColumn Header="Where" Width="130"
                                                    Binding="{Binding Location}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Type" Width="*"
                                                    Binding="{Binding Description}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Value (partly hidden)" Width="170"
                                                    Binding="{Binding MaskedValue}"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{Binding HiddenTabHeader}">
                        <DataGrid ItemsSource="{Binding HiddenItems}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                                  BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                  RowHeight="30" ColumnHeaderHeight="30" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Width="84"
                                                    Binding="{Binding Severity}"
                                                    ElementStyle="{StaticResource SeverityText}"/>
                                <DataGridTextColumn Header="Kind" Width="140"
                                                    Binding="{Binding CategoryName}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="What was found" Width="*"
                                                    Binding="{Binding What}"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0" ToolTip="{Binding Status}"/>
            </Grid>
        </Border>

        <!-- ================= RIGHT: what to check against ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Check against" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding ProfileSummary}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="What it looks for" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding LooksForText}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource InkBrush}"/>

                        <TextBlock Text="What it can't find (you need to check these)" Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding CannotFindText}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource InkBrush}"/>

                        <TextBlock Text="Also look for these words or names (one per line)" Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,4"/>
                        <TextBox Style="{StaticResource Input}" AcceptsReturn="True" Height="72"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Text="{Binding CustomTermsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Client names, patient names, case numbers: anything the built-in checks can't recognise by shape. Matches ignore capital letters."/>

                        <TextBlock Text="Hidden content" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <CheckBox Content="Also look for hidden content" Style="{StaticResource FindCheck}"
                                  IsChecked="{Binding CheckHiddenContent}"
                                  ToolTip="Looks inside Word (.docx), PDF, JPEG and PNG files for what is stored but not shown on the pages: author names and other properties, comments, tracked changes and deleted text, hidden text, attached files, scripts, page previews, location data, and earlier saved versions. Text found there is checked too."/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Word (.docx), PDF, JPEG and PNG files. Older Word files (.doc, .rtf) and other picture types can't be checked for this."/>

                        <Expander Header="What a clean copy removes" Margin="0,10,0,0" Padding="0">
                            <StackPanel Margin="4,6,0,0">
                                <CheckBox Content="Author and other document properties" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanProperties}"/>
                                <CheckBox Content="Comments" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanComments}"/>
                                <CheckBox Content="Tracked changes (accepts them all)" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanTrackedChanges}"
                                          ToolTip="Deleted text is removed for good and inserted text stays. This changes the document's text."/>
                                <CheckBox Content="Text formatted as hidden" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanHiddenText}"
                                          ToolTip="Deletes it from the copy. This changes the document's text."/>
                                <CheckBox Content="Attached and embedded files" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanAttachments}"/>
                                <CheckBox Content="First-page preview picture" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanPreviews}"/>
                                <CheckBox Content="Picture metadata (location, camera, dates)" Style="{StaticResource FindCheck}" IsChecked="{Binding CleanPictures}"/>
                                <CheckBox Content="Keep rebuilt PDFs searchable" Style="{StaticResource FindCheck}" IsChecked="{Binding KeepPdfSearchable}"
                                          ToolTip="PDFs are cleaned by rebuilding each page as a picture, which removes everything hidden in them. This adds the page text back as an invisible layer so the copy can be searched."/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Clean copies are new files; your originals are never changed. Pick what to remove here, then press Clean copies…"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Scan files" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}"/>
                        <Button Content="Save report…" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SaveReportCommand}" Margin="8,0,0,0"
                                ToolTip="Saves a web page (opens in any browser, prints to PDF) or a CSV spreadsheet. Found values are partly hidden."/>
                        <Button Content="Clean copies…" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CleanCommand}" Margin="8,0,0,0"
                                ToolTip="After a scan: makes clean copies of the files that have hidden content, in a folder you choose. Originals are never changed."/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="This check helps you review documents. It is a first pass, not a guarantee: it can miss things and flag harmless ones, and it does not certify that anything meets a law or standard. Have a person review the documents too."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
